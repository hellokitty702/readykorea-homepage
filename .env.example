# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL=postgres://user:password@localhost:5432/readykorea

# Media uploads (lib/storage.ts). Without R2_BUCKET, files are kept in ./storage/ and served at /uploads/….
# Production: Cloudflare R2. Create a bucket, give it a public URL (custom domain or r2.dev), and an
# API token with Object Read & Write on that bucket.
# STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, no trailing slash, e.g. https://media.readykoreaesl.com
R2_PUBLIC_URL=

# Site address for canonical tags, sitemap.xml, robots.txt and JSON-LD (lib/site.ts). Optional: on Vercel
# the production domain is used, locally http://localhost:3000. Set it to pin the address, e.g.
# SITE_URL=https://readykoreaesl.com
SITE_URL=
